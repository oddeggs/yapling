{
  "name": "@yapling/art-sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Copies the prototype's art generators (design/prototype/art/*.js) into @yapling/art and checks they are current",
  "scripts": {
    "sync": "tsx src/cli.ts",
    "check": "tsx src/cli.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
