# Selects the app.config.ts variant: dev | prd. Unset means dev.
APP_VARIANT=dev
# Points the app at another API, e.g. http://<this Mac's LAN address>:8787/api for `wrangler dev`
# on a phone. Unset means the variant's default (dev: http://127.0.0.1:8787/api, which the
# simulator reaches on this Mac).
API_BASE=
# The EAS project id. Unset leaves the build unlinked from EAS, with updates off.
EAS_PROJECT_ID=
# RevenueCat's public iOS SDK key for this variant (Yapling Dev or Yapling). Unset: nothing can be
# bought; a development build's paywall shows sample prices marked dev-only.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# PostHog's project API key (public, `phc_…`) for this variant's project, and its host. Unset key:
# no analytics at all (the SDK is never loaded, nothing is sent). Unset host: PostHog EU cloud.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
# Sentry's DSN for crash reports (public). Unset: no crash reports (the SDK is never started).
EXPO_PUBLIC_SENTRY_DSN=
# Source-map and debug-symbol upload from release builds: all three set, or the upload steps are
# skipped (the build needs no Sentry account). The auth token is a secret: an EAS secret, never git.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
