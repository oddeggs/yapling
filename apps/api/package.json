{
  "name": "@yapling/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Yapling API: Hono on Cloudflare Workers with the call and user Durable Objects, D1, R2 and Queues, served at <host>/api",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@yapling/contracts": "workspace:*",
    "@yapling/domain": "workspace:*",
    "@yapling/story": "workspace:*",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:workers",
    "wrangler": "catalog:"
  }
}
